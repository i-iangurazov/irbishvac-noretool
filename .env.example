# Default business-unit groups
ST_BU_INSTALLERS=1809,64313020
ST_BU_ADVISORS=1812,64326403,64567559
ST_BU_COMPANY=1809,1810,1812,64313020,64315277,64326403,64567559,64569092,64569731

# Optional public Cloudflare R2 asset host
R2_PUBLIC_BASE_URL=
R2_TECHNICIAN_PHOTO_EXT=png
R2_TECHNICIAN_PHOTO_NAME_STYLE=space
R2_LOGO_KEY=irbis-logo_new_cmyk.png

# Retool storage asset folders to preserve current matching semantics
ASSET_FOLDER_TECHNICIAN_PHOTOS=technicians_photos
ASSET_FOLDER_LOGOS=

# Campaign performance live sources. Share the spreadsheet with the service
# account email as Viewer; keep the private key server-side only.
GOOGLE_CALL_CENTER_SPREADSHEET_ID=1b1aZBH1cd5KSJwtpop8Wlpgm0Gfv-DR9zwh0Blunu60
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Google Local Services Reporting API OAuth (Worker service only).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_LSA_MANAGER_CUSTOMER_ID=
GOOGLE_LSA_CUSTOMER_ID=
YELP_API_KEY=
YELP_BUSINESS_IDS=
# Meta Marketing API system-user token (Worker service only).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_GRAPH_API_VERSION=v23.0
CAMPAIGN_COMPANY_REVENUE_GOAL=2000000
CAMPAIGN_MARKETING_BUDGET_RATE=0.07
CAMPAIGN_OPPORTUNITY_GOAL=1125
CAMPAIGN_TARGET_BOOKING_RATE=0.60

# Thursday technician coaching report delivery. SMTP credentials and EMAIL_FROM
# are read from the marketing agent env file by the delivery runner.
TECH_REPORTS_ENABLED=false
TECH_REPORT_SEND_WEEKDAY=THU
TECH_REPORT_SEND_HOUR=6
TECH_REPORT_SEND_MINUTE=30
TECH_REPORT_SEND_WINDOW_MINUTES=20
TECH_REPORT_HVAC_MANAGER_EMAIL=
TECH_REPORT_PLUMBING_MANAGER_EMAIL=
VADIM_EMAIL=
TECH_REPORT_VERSION=V7
TECH_REPORT_GOALS_FILE=/absolute/path/to/irbishvac-noretool/docs/august-2026-performance-goals.csv
TECH_REPORT_HHR_EFFECTIVE_DATE=2026-07-23
